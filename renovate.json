{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommitType(chore)"
  ],
  "enabledManagers": [
    "gomod",
    "github-actions",
    "kubernetes",
    "mise",
    "custom.regex"
  ],
  "kubernetes": {
    "managerFilePatterns": ["/^deploy/.+\\.yaml$/"]
  },
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "commitMessagePrefix": "chore(all): ",
  "commitMessageAction": "update",
  "commitBody": "Signed-off-by: Renovate Bot <bot@renovateapp.com>",
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 50,
  "prHourlyLimit": 0,
  "platformAutomerge": true,
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "ignoreTests": false,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "automerge": true,
    "minimumReleaseAge": "0 days"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Makefile tool versions via inline renovate comments",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: registryUrl=(?<registryUrl>[^\\s]+))?(?: versioning=(?<versioning>[^\\s]+))?\\n[A-Z_]+\\s*[?:]?=\\s*(?<currentValue>[^\\s]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Wait 3 days before automerging major updates",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group GitHub Actions into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Bump Go version in go.mod to latest patch",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Group Dapr SDK dependencies",
      "matchPackageNames": ["/^github.com\\/dapr/"],
      "groupName": "Dapr SDK"
    },
    {
      "description": "Group all toolchain pins (Makefile + .mise.toml) into one PR",
      "matchManagers": ["custom.regex", "mise"],
      "groupName": "Toolchain"
    },
    {
      "description": "PlantUML renderer: no automerge — a bump can change PNG bytes, and the hosted bot cannot run `make diagrams` to re-render + commit. A human shepherds each bump (make diagrams, commit PNGs). Own group so this does not disable Toolchain automerge.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["plantuml/plantuml"],
      "groupName": "PlantUML renderer",
      "automerge": false
    }
  ]
}
