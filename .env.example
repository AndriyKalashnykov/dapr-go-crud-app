# .env.example — committed source of truth for operator-tunable values.
#
# Copy to `.env` (gitignored) and edit; the Makefile's `-include .env` makes your
# overrides authoritative for `make` (a value set here wins over the Makefile's
# `?=` default). Only `?=` Makefile vars are overridable this way — Renovate-tracked
# `:=` image/tool pins (MONGO_VERSION, ZIPKIN_VERSION, ACT_UBUNTU_VERSION,
# MERMAID_CLI_VERSION, PLANTUML_VERSION) are fixed in the Makefile and NOT listed here.
#
#   cp .env.example .env    # then edit .env for your environment

# --- Image publishing (ko) ---
# GHCR repo-namespace path so GITHUB_TOKEN can publish (the user-namespace path
# needs a PAT). Override for a different registry, e.g.
# docker.io/<youruser>/dapr-go-crud-app.
KO_DOCKER_REPO=ghcr.io/andriykalashnykov/dapr-go-crud-app
# Multi-arch publish target. Narrow to a single arch (e.g. linux/amd64) for
# faster local dev builds.
KO_PLATFORMS=linux/amd64,linux/arm64

# --- Kubernetes / Dapr ---
# Namespace the app manifests deploy into.
APP_NAMESPACE=crud-app
# Local KinD cluster name (make kind-up / make e2e).
KIND_CLUSTER_NAME=dapr-go-crud-app
# Dapr control-plane Helm chart version (Renovate-tracked in the Makefile).
# Uncomment + set only to pin a different Dapr version for your cluster.
#DAPR_HELM_VERSION=1.17.1

# --- E2E smoke harness (scripts/e2e-smoke.sh) ---
# Container-internal HTTP port the app services listen on (Dapr app-port).
APP_INTERNAL_PORT=8080
# Local port-forward ports. Leave COMMENTED for a kernel-ephemeral port
# (parallel-run safe — two e2e runs never collide). Uncomment + set a fixed
# value only if you need a stable local port; the harness fails early, naming
# the holder, if that port is already in use.
#E2E_LOCAL_CRUD_PORT=18080
#E2E_LOCAL_TIMELINE_PORT=18081
# Component start-up loop: wait for every Deployment to become Available.
E2E_POD_READY_TIMEOUT=180          # per kubectl-wait timeout, seconds
E2E_COMPONENT_START_ATTEMPTS=30    # start-loop attempts
E2E_COMPONENT_START_DELAY=5        # delay between start-loop attempts, seconds
# Port-forward readiness poll.
E2E_PORTFWD_ATTEMPTS=30
E2E_PORTFWD_DELAY=1                 # seconds
# Assertion poll budgets.
E2E_PUBSUB_TIMEOUT=90              # pubsub propagation budget, seconds
E2E_REPOST_INTERVAL=10            # re-POST cadence during pubsub poll, seconds
E2E_INVOKE_ATTEMPTS=45
E2E_INVOKE_DELAY=2                 # seconds
E2E_FANOUT_ATTEMPTS=30
E2E_FANOUT_DELAY=2                 # seconds
# service-c 'events' fan-out is a hard assertion by default. Set false only to
# downgrade a known-broken service-c subscription to a warning (investigation).
E2E_REQUIRE_SERVICE_C_FANOUT=true

# --- Integration test container images (make integration-test) ---
# The Testcontainers integration tests (pkg/storage/*_integration_test.go) read
# these with a literal fallback. By default `make integration-test` single-sources
# them from the Renovate-tracked Makefile pins (REDIS_VERSION, DAPR_HELM_VERSION,
# MONGO_VERSION), so leave them COMMENTED. Uncomment + set only to pin a
# DIFFERENT image than the Makefile default (e.g. a local mirror or a debug tag).
#REDIS_IMAGE=redis:8-alpine
#DAPRD_IMAGE=daprio/daprd:1.18.1
#MONGO_IMAGE=mongo:8.0

# --- Image smoke test (scripts/image-smoke-test.sh) ---
# Seconds to let each container boot (or crash-loop) before the running-check.
# Dapr-client binaries that dial a sidecar need this ≥ the SDK's dial deadline.
SMOKE_BOOT_DELAY=5

# --- CI run cleanup (make cleanup-runs / cleanup-runs.yml) ---
# Delete workflow runs older than this many days...
RETAIN_DAYS=7
# ...but always keep at least this many most-recent runs.
KEEP_MINIMUM=5
# GitHub repo (owner/name) for cleanup. Auto-detected via `gh` by default;
# set only if that detection fails.
#GH_REPO=AndriyKalashnykov/dapr-go-crud-app
